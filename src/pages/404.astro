---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404" description="Error 404 - Page not found" noindex={true}>
  <section
    class="bg-bg min-h-screen flex flex-col items-center justify-center px-6 text-center"
  >
    <h1
      class="text-7xl md:text-8xl font-extrabold text-accent drop-shadow-[3px_3px_0_var(--color-primary)] mb-6"
    >
      404
    </h1>

    <h2 class="text-2xl md:text-3xl text-white font-semibold mb-6">
      Página no encontrada :/
    </h2>

    <p class="text-white/80 max-w-md mx-auto mb-10 font-bold">
      El enlace al que intentaste acceder no existe o fue movido. Pero
      tranquilo, podés volver al inicio y seguir navegando.
    </p>

    <a
      href="/"
      class="rounded-full bg-accent px-8 py-3 text-lg font-bold text-ink drop-shadow-[3px_3px_0_var(--color-primary)] transition-all duration-150 active:translate-y-0.5 active:drop-shadow-none"
    >
      Volver al inicio
    </a>
  </section>
</Layout>
