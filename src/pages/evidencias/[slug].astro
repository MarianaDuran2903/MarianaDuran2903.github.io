---
import {
  HiArrowLeft,
  HiArrowTopRightOnSquare,
  HiDocumentText,
  HiLightBulb,
  HiCheckCircle,
} from "react-icons/hi2";
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/commons/banners/banner.astro";
import { evidencias } from "../../data/evidenceData.js";

export function getStaticPaths() {
  return evidencias.map((evidencia) => ({
    params: { slug: evidencia.slug },
    props: { evidencia },
  }));
}

const { evidencia } = Astro.props;

const {
  titulo,
  tema,
  descripcionLarga,
  enunciado,
  tecnologias,
  demo,
  codigo,
  pdfUrl,
  pdfUrlSolucion,
  conceptosAplicados,
} = evidencia;

const documentos = [
  { label: "Enunciado", url: pdfUrl },
  { label: "Solución", url: pdfUrlSolucion },
]
  .filter((doc) => doc.url && doc.url.trim() !== "")
  .map((doc) => ({ ...doc, esPdf: doc.url.toLowerCase().endsWith(".pdf") }));

const recursos = [
  { url: demo, label: "Documento relacionado" },
  { url: codigo, label: "Código / Recurso relacionado" },
].filter((r) => r.url && r.url.trim() !== "" && r.url !== pdfUrl);
---

<Layout title={titulo} description={tema}>
  <main class="mx-auto max-w-4xl px-4 pt-28 pb-16 sm:px-6">
    <!-- (1) Volver a Evidencias -->
    <a
      href="/evidencias"
      class="group inline-flex items-center gap-1.5 text-sm font-semibold text-primary-light transition-colors hover:text-primary"
    >
      <HiArrowLeft className="transition-transform duration-200 group-hover:-translate-x-1" size={16} />
      Volver a Evidencias
    </a>

    <!-- (2) Título + tema -->
    <header class="mt-6 mb-10 text-center">
      <h1 class="text-3xl font-extrabold text-white drop-shadow-[2px_2px_0_var(--color-primary)] sm:text-4xl">
        {titulo}
      </h1>
      <p class="mt-2 text-lg text-gray-400">{tema}</p>

      {
        tecnologias?.length > 0 && (
          <div class="mt-4 flex flex-wrap justify-center gap-2">
            {tecnologias.map((tech) => (
              <span class="rounded-md bg-primary/20 px-2 py-0.5 text-xs font-semibold text-primary-light">
                {tech}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <div class="flex flex-col gap-8">
      <!-- (3) Descripción del Proyecto -->
      <section class="rounded-xl bg-surface p-6 shadow-lg drop-shadow-[4px_4px_0_var(--color-primary)] sm:p-8">
        <h2 class="mb-4 flex items-center gap-2 text-2xl font-bold text-white">
          <HiDocumentText class="shrink-0 text-primary-light" size={22} />
          Descripción del Proyecto
        </h2>
        <p class="text-justify leading-relaxed whitespace-pre-line text-gray-300">{descripcionLarga}</p>
      </section>

      <!-- (4) Enunciado -->
      <section class="rounded-xl bg-surface p-6 shadow-lg drop-shadow-[4px_4px_0_var(--color-primary)] sm:p-8">
        <h2 class="mb-4 flex items-center gap-2 text-2xl font-bold text-white">
          <HiLightBulb class="shrink-0 text-primary-light" size={22} />
          Enunciado
        </h2>
        <p class="text-justify leading-relaxed whitespace-pre-line text-gray-300">{enunciado}</p>
      </section>

      <!-- (5) Visor de PDF + descarga/link externo -->
      <section class="rounded-xl bg-surface p-6 shadow-lg drop-shadow-[4px_4px_0_var(--color-primary)] sm:p-8">
        <h2 class="mb-4 flex items-center gap-2 text-2xl font-bold text-white">
          <HiDocumentText class="shrink-0 text-primary-light" size={22} />
          {documentos.length > 1 ? "Documentos" : "Documento"}
        </h2>

        {
          documentos.length === 0 ? (
            <p class="text-center text-gray-400">Aún no hay un documento cargado para este trabajo.</p>
          ) : (
            <div class="flex flex-col gap-8">
              {documentos.map((doc) => (
                <div>
                  {documentos.length > 1 && (
                    <h3 class="mb-2 text-sm font-semibold tracking-wide text-primary-light uppercase">
                      {doc.label}
                    </h3>
                  )}

                  {doc.esPdf ? (
                    <iframe
                      src={doc.url}
                      title={`${doc.label} de ${titulo}`}
                      class="h-[600px] w-full rounded-lg border border-white/10 bg-white"
                    />
                  ) : (
                    <p class="text-center text-gray-400">
                      Este trabajo no tiene un PDF local embebible; usa el enlace de abajo para consultarlo.
                    </p>
                  )}

                  <div class="mt-4 flex justify-center">
                    <a
                      href={doc.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      download={doc.esPdf}
                      class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-1.5 text-sm font-bold text-ink drop-shadow-[2px_2px_0_var(--color-primary)] transition-all duration-150 hover:bg-accent-hover active:translate-y-0.5 active:drop-shadow-none"
                    >
                      {doc.esPdf ? `Descargar ${documentos.length > 1 ? doc.label : "PDF"}` : "Abrir recurso externo"}
                      <HiArrowTopRightOnSquare size={16} />
                    </a>
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </section>

      <!-- (6) Conceptos Aplicados y Aprendidos -->
      <section class="rounded-xl bg-surface p-6 shadow-lg drop-shadow-[4px_4px_0_var(--color-primary)] sm:p-8">
        <h2 class="mb-4 flex items-center gap-2 text-2xl font-bold text-white">
          <HiCheckCircle class="shrink-0 text-primary-light" size={22} />
          Conceptos Aplicados y Aprendidos
        </h2>
        {
          conceptosAplicados?.length > 0 ? (
            <ul class="grid gap-2.5 sm:grid-cols-2">
              {conceptosAplicados.map((concepto) => (
                <li class="flex items-start gap-2 rounded-lg bg-white/5 px-3 py-2 text-sm text-gray-300">
                  <HiCheckCircle class="mt-0.5 shrink-0 text-primary" size={16} />
                  <span>{concepto}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-center text-gray-400">Aún no hay conceptos registrados para este trabajo.</p>
          )
        }
      </section>

      <!-- (7) Para conocer más (opcional) -->
      {
        recursos.length > 0 && (
          <section class="rounded-xl bg-surface p-6 shadow-lg drop-shadow-[4px_4px_0_var(--color-primary)] sm:p-8">
            <h2 class="mb-4 text-2xl font-bold text-white">Para conocer más</h2>
            <div class="flex flex-wrap gap-3">
              {recursos.map((recurso) => (
                <a
                  href={recurso.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1.5 rounded-full bg-white/5 px-4 py-2 text-sm font-semibold text-primary-light transition-colors hover:bg-white/10 hover:text-primary"
                >
                  {recurso.label}
                  <HiArrowTopRightOnSquare
                    className="transition-transform duration-200 group-hover:translate-x-1"
                    size={14}
                  />
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </main>

  <Banner />
</Layout>
