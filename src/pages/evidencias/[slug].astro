---
import { HiArrowLeft, HiArrowTopRightOnSquare } from "react-icons/hi2";
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/commons/banners/banner.astro";
import { evidencias } from "../../data/evidenceData.js";

export function getStaticPaths() {
  return evidencias.map((evidencia) => ({
    params: { slug: evidencia.slug },
    props: { evidencia },
  }));
}

const { evidencia } = Astro.props;

const {
  titulo,
  tema,
  descripcionLarga,
  enunciado,
  tecnologias,
  demo,
  codigo,
  pdfUrl,
  conceptosAplicados,
} = evidencia;

const tienePdf = Boolean(pdfUrl && pdfUrl.trim() !== "");
const esPdfEmbebible = tienePdf && pdfUrl.toLowerCase().endsWith(".pdf");

const recursos = [
  { url: demo, label: "Documento relacionado" },
  { url: codigo, label: "Código / Recurso relacionado" },
].filter((r) => r.url && r.url.trim() !== "" && r.url !== pdfUrl);
---

<Layout title={titulo} description={tema}>
  <main class="mx-auto max-w-4xl px-4 pt-28 pb-16 sm:px-6">
    <!-- (1) Volver a Evidencias -->
    <a
      href="/evidencias"
      class="group inline-flex items-center gap-1.5 text-sm font-semibold text-primary-light transition-colors hover:text-primary"
    >
      <HiArrowLeft className="transition-transform duration-200 group-hover:-translate-x-1" size={16} />
      Volver a Evidencias
    </a>

    <!-- (2) Título + tema -->
    <header class="mt-6 mb-10">
      <h1 class="text-3xl font-extrabold text-white drop-shadow-[2px_2px_0_var(--color-primary)] sm:text-4xl">
        {titulo}
      </h1>
      <p class="mt-2 text-lg text-gray-400">{tema}</p>

      {
        tecnologias?.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tecnologias.map((tech) => (
              <span class="rounded-md bg-primary/20 px-2 py-0.5 text-xs font-semibold text-primary-light">
                {tech}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <!-- (3) Descripción del Proyecto -->
    <section class="mb-10">
      <h2 class="mb-3 text-2xl font-bold text-white drop-shadow-[1px_1px_0_var(--color-primary)]">
        Descripción del Proyecto
      </h2>
      <p class="whitespace-pre-line text-gray-300">{descripcionLarga}</p>
    </section>

    <!-- (4) Enunciado -->
    <section class="mb-10">
      <h2 class="mb-3 text-2xl font-bold text-white drop-shadow-[1px_1px_0_var(--color-primary)]">
        Enunciado
      </h2>
      <p class="whitespace-pre-line text-gray-300">{enunciado}</p>
    </section>

    <!-- (5) Visor de PDF + descarga/link externo -->
    <section class="mb-10">
      <h2 class="mb-3 text-2xl font-bold text-white drop-shadow-[1px_1px_0_var(--color-primary)]">
        Documento
      </h2>

      {
        esPdfEmbebible ? (
          <iframe
            src={pdfUrl}
            title={`Documento de ${titulo}`}
            class="h-[600px] w-full rounded-lg border border-white/10 bg-white"
          />
        ) : (
          <p class="text-gray-400">
            {tienePdf
              ? "Este trabajo no tiene un PDF local embebible; usa el enlace de abajo para consultarlo."
              : "Aún no hay un documento cargado para este trabajo."}
          </p>
        )
      }

      {
        tienePdf && (
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            download={esPdfEmbebible}
            class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-1.5 text-sm font-bold text-ink drop-shadow-[2px_2px_0_var(--color-primary)] transition-all duration-150 hover:bg-accent-hover active:translate-y-0.5 active:drop-shadow-none"
          >
            {esPdfEmbebible ? "Descargar PDF" : "Abrir recurso externo"}
            <HiArrowTopRightOnSquare size={16} />
          </a>
        )
      }
    </section>

    <!-- (6) Conceptos Aplicados y Aprendidos -->
    <section class="mb-10">
      <h2 class="mb-3 text-2xl font-bold text-white drop-shadow-[1px_1px_0_var(--color-primary)]">
        Conceptos Aplicados y Aprendidos
      </h2>
      {
        conceptosAplicados?.length > 0 ? (
          <ul class="list-disc space-y-1 pl-5 text-gray-300">
            {conceptosAplicados.map((concepto) => (
              <li>{concepto}</li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-400">Aún no hay conceptos registrados para este trabajo.</p>
        )
      }
    </section>

    <!-- (7) Para conocer más (opcional) -->
    {
      recursos.length > 0 && (
        <section class="mb-10">
          <h2 class="mb-3 text-2xl font-bold text-white drop-shadow-[1px_1px_0_var(--color-primary)]">
            Para conocer más
          </h2>
          <ul class="space-y-2">
            {recursos.map((recurso) => (
              <li>
                <a
                  href={recurso.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1.5 font-semibold text-primary-light transition-colors hover:text-primary"
                >
                  {recurso.label}
                  <HiArrowTopRightOnSquare
                    className="transition-transform duration-200 group-hover:translate-x-1"
                    size={14}
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Banner />
</Layout>
