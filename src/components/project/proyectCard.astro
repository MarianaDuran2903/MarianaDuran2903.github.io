---
export interface Props {
  titulo: string;
  descripcion: string;
  tecnologias: string[];
  categoria?: string;
  slug: string;
  index: number;
}

const { titulo, descripcion, tecnologias, categoria, slug, index } = Astro.props;
---

<a
  href={`/evidencias/${slug}`}
  data-index={index}
  data-categoria={categoria ?? ""}
  class="project-card z-10 flex w-[400px] flex-col overflow-hidden rounded-lg bg-surface p-4 shadow-lg transition-transform hover:scale-[1.01] lg:w-[320px] drop-shadow-[4px_4px_0_var(--color-primary)]"
>
  <h3 class="text-xl font-semibold text-white drop-shadow-[1px_1px_0_var(--color-primary)]">{titulo}</h3>

  <div class="my-1.5 flex flex-wrap gap-2">
    {
      tecnologias.map((tech) => (
        <span class="rounded-md bg-primary/20 text-primary-light px-2 py-0.5 text-xs font-semibold">
          {tech}
        </span>
      ))
    }
  </div>

  <p class="line-clamp-3 flex grow text-gray-400">{descripcion}</p>
</a>
