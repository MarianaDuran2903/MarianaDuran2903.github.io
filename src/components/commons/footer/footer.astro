---
import SocialIcons from "../socialIcons/socialIcons.jsx";
---

<footer class="bg-bg text-white">
  <div
    class="container mx-auto flex flex-col items-center justify-between px-6 py-12 lg:flex-row lg:px-20"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center">
      <h3
        class="text-accent text-4xl font-bold drop-shadow-[1.5px_1.5px_0_var(--color-primary)]"
      >
        MCP
      </h3>
    </a>

    <!-- Navigation Links -->
    <nav class="mb-4 lg:mb-0">
      <ul
        class="flex flex-col items-center space-y-2 text-gray-400 lg:flex-row lg:items-start lg:space-y-0 lg:space-x-6"
      >
        <li>
          <a href="/" class="hover:text-secondary-alt font-semibold">Inicio</a>
        </li>
        <li>
          <a href="/evidencias" class="hover:text-secondary-alt font-semibold">Evidencias</a>
        </li>
        <li>
          <a href="/lautaro" class="hover:text-secondary-alt font-semibold"
            >Presentación</a>
        </li>
        <li>
          <a href="/links" class="hover:text-secondary-alt font-semibold"
            >Contacto</a>
        </li>
      </ul>
    </nav>

    <!-- Social Media Links -->
    <div class="flex space-x-4 ">
      <SocialIcons client:visible />
    </div>
  </div>

  <!-- Copyright -->
  <div
    class="w-full border-t border-gray-600 py-10 text-center text-sm text-gray-500"
  >
    mcduranp@unbosque.edu.co
  </div>
</footer>
